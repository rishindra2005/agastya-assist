# Agastya Assist Configuration

# Sarvam AI API Key for STT/TTS (optional)
SARVAM_API_KEY=

# Agent model name
AGENT_MODEL=claude-sonnet-5-5

# Directory for SQLite DB and local data
DATA_DIR=./data

# Run browser in headless mode
HEADLESS=true
# Use the installed Google Chrome instead of bundled Chromium (recommended with HEADLESS=false for live portals)
BROWSER_CHANNEL=

# Default spoken/display language code
DEFAULT_LANGUAGE=hi-IN

# Chrome DevTools port (0 = auto), Playwright MCP for the agent, live stream settings
CDP_PORT=0
PLAYWRIGHT_MCP=true
LIVE_QUALITY=60
LIVE_MAX_WIDTH=1280
